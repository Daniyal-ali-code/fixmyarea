# FixMyArea — environment variables (Supabase)
# Copy to .env.local and fill in the real values. Never commit .env.local.
# Get the values from the Supabase Dashboard for the "fixmyarea" project:
#   Settings > Database > Connection string > Transaction pooler (port 6543)
#   Settings > API > Project URL / anon public key / service_role key

# Supabase Postgres pooler (port 6543, SSL required). The password is
# the database password chosen when the project was created.
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project URL (public; also used by the browser, hence NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/public key (public; used only for the Storage public URL base)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Supabase service-role key (SECRET — server only, never expose to the
# browser). Used for Storage uploads; it bypasses Storage RLS.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Secret used to sign the app's own JWT auth cookies (custom auth, NOT
# Supabase Auth). Generate a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=<long-random-string>

# Password reset emails (SMTP) — needed for /forgot-password to work.
# Without these, POST /api/auth/forgot-password answers 503.
# Easiest options: a Gmail app password (myaccount.google.com/apppasswords,
# host smtp.gmail.com, port 587), or Resend / SendGrid (host
# smtp.resend.com / smtp.sendgrid.net, port 587, user "resend" / "apikey").
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
# Address the reset email is sent from (defaults to SMTP_USER).
SMTP_FROM=<noreply@yourdomain.com>
